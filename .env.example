# Required: Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: ServiceDesk Plus base URL (no trailing slash needed)
SDP_BASE_URL=https://sdp.example.com

# Required: ServiceDesk Plus technician/service API token
SDP_SERVICE_TOKEN=

# Required: ServiceDesk Plus field storing the technician's Telegram username/ID
SDP_TELEGRAM_FIELD=

# Required: 32-byte AES-256 key (64 hex chars, base64, or raw 32-byte string)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional: SQLite database file path (default: ./data/bot.db; Docker Compose overrides to /app/data/bot.db)
DB_PATH=./data/bot.db

# Optional: Number of requests per page, 1-50 (default: 8)
REQUESTS_PER_PAGE=8

# Optional: Update mode: polling or webhook (default: polling)
BOT_MODE=polling

# Required when BOT_MODE=webhook: Public HTTPS URL for Telegram webhook
WEBHOOK_URL=

# Optional: Webhook HTTP server listen address (default: :8443)
WEBHOOK_LISTEN_ADDR=:8443

# Optional: Secret token sent by Telegram in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# Optional: Skip TLS certificate verification for SDP (default: false)
SDP_INSECURE_TLS=false

# Optional: Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
